# Must contain an existing metadata.pegasus.txt and the named collection.
PEGASUS_DIR=./arcade
PEGASUS_COLLECTION=Coding Pirates
# Optional: defaults to PEGASUS_DIR/games, or the working directory without Pegasus.
# SCRATCH_OUTPUT_DIR=./arcade/games
# Optional local importer settings.
IMPORTER_LANGUAGE=en
# Supported languages: en (English), da (Danish).
# IMPORTER_PORT=4173
# IMPORTER_BROWSER=C:/Program Files/Google/Chrome/Application/chrome.exe